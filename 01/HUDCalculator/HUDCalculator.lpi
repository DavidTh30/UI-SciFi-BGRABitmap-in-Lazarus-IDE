<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="HUD Calculator"/>
      <Scaled Value="True"/>
      <ResourceType Value="res"/>
      <UseXPManifest Value="True"/>
      <XPManifest>
        <DpiAware Value="True"/>
      </XPManifest>
    </General>
    <BuildModes>
      <Item Name="Release" Default="True"/>
      <Item Name="Debug">
        <CompilerOptions>
          <Version Value="11"/>
          <Target>
            <Filename Value="HUDCalculator"/>
          </Target>
          <SearchPaths>
            <IncludeFiles Value="$(ProjOutDir)"/>
            <OtherUnitFiles Value="..\shared;..\OpticScanner;..\TargetLock;..\ShieldCore;..\HUDIconSet;..\DataFrames;..\RadarSweep;..\HexCore;..\TargetCrosshair;..\ChevronLoader;..\PillLoader;..\BlockLoader;..\SlantLoader"/>
            <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
          </SearchPaths>
          <Parsing>
            <SyntaxOptions>
              <IncludeAssertionCode Value="True"/>
            </SyntaxOptions>
          </Parsing>
          <CodeGeneration>
            <Checks>
              <IOChecks Value="True"/>
              <RangeChecks Value="True"/>
              <OverflowChecks Value="True"/>
              <StackChecks Value="True"/>
            </Checks>
            <VerifyObjMethodCallValidity Value="True"/>
          </CodeGeneration>
          <Linking>
            <Debugging>
              <DebugInfoType Value="dsDwarf3"/>
              <UseHeaptrc Value="True"/>
              <TrashVariables Value="True"/>
              <UseExternalDbgSyms Value="True"/>
            </Debugging>
            <Options>
              <Win32>
                <GraphicApplication Value="True"/>
              </Win32>
            </Options>
          </Linking>
        </CompilerOptions>
      </Item>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="MultiThreadProcsLaz"/>
      </Item>
      <Item>
        <PackageName Value="BGRABitmapPack"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="HUDCalculator.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="uhudcalculator.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="UHUDCalculator"/>
      </Unit>
      <Unit>
        <Filename Value="..\shared\hudcore.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="HUDCore"/>
      </Unit>
      <Unit>
        <Filename Value="..\shared\hudhost.pas"/>
        <IsPartOfProject Value="True"/>
        <UnitName Value="HUDHost"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
      <Version Value="11"/>
      <Target>
        <Filename Value="HUDCalculator"/>
      </Target>
      <SearchPaths>
        <IncludeFiles Value="$(ProjOutDir)"/>
        <OtherUnitFiles Value="..\shared;..\OpticScanner;..\TargetLock;..\ShieldCore;..\HUDIconSet;..\DataFrames;..\RadarSweep;..\HexCore;..\TargetCrosshair;..\ChevronLoader;..\PillLoader;..\BlockLoader;..\SlantLoader"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <CodeGeneration>
        <SmartLinkUnit Value="True"/>
        <Optimizations>
          <OptimizationLevel Value="3"/>
        </Optimizations>
      </CodeGeneration>
      <Linking>
        <Debugging>
          <GenerateDebugInfo Value="False"/>
          <RunWithoutDebug Value="True"/>
        </Debugging>
        <LinkSmart Value="True"/>
        <Options>
          <Win32>
            <GraphicApplication Value="True"/>
          </Win32>
        </Options>
      </Linking>
  </CompilerOptions>
</CONFIG>
